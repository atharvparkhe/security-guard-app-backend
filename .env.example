# Copy to .env for local development:
#   cp .env.example .env
#
# Setup:
#   python -m venv .venv
#   source .venv/bin/activate   # Windows: .venv\Scripts\activate
#   pip install -r requirements.txt
#   python manage.py migrate
#   python manage.py createsuperuser
#   python manage.py runserver

# Development (core.settings.dev)
SECRET_KEY=dev-insecure-change-me

# Production (core.settings.prod) — set DJANGO_SETTINGS_MODULE=core.settings.prod
# SECRET_KEY=required-long-random-string
# ALLOWED_HOSTS=example.com,www.example.com
# DATABASE_URL=postgres://user:password@localhost:5432/dbname
# Resend (recommended) — verify your domain at https://resend.com/domains
RESEND_API_KEY=re_xxxxxxxx
DEFAULT_FROM_EMAIL=Security Guard <noreply@yourdomain.com>

# SMTP fallback (prod only, when RESEND_API_KEY is unset)
# EMAIL_HOST=smtp.example.com
# EMAIL_PORT=587
# EMAIL_HOST_USER=
# EMAIL_HOST_PASSWORD=
# EMAIL_USE_TLS=true
# After migrate: python manage.py createcachetable
